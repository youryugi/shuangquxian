# 模型权重
*.pth
*.pt
*.onnx
*.pkl
*.h5
*.bin

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 训练输出：可视化图片不入库（数据集图片在 data/ 下，不受影响）
experiments/**/*.png
experiments/**/*.jpg

# LaTeX 编译中间文件
paper/**/*.aux
paper/**/*.log
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
paper/**/*.blg
paper/**/*.out

# Jupyter
.ipynb_checkpoints/

# 训练输出目录（revision 阶段）：每个 run 的预测/日志/权重不入库，只保留汇总
experiments/revision/basic_ds2/runs*/**
!experiments/revision/basic_ds2/runs_cv/cv_summary.md
!experiments/revision/basic_ds2/runs_cv/cv_summary.json
!experiments/revision/basic_ds2/runs_cv/refine/
experiments/revision/basic_ds2/runs_cv/refine/**
!experiments/revision/basic_ds2/runs_cv/refine/summary.md
!experiments/revision/basic_ds2/runs_cv/refine/summary.json
experiments/revision/detector_comparison/runs*/
experiments/revision/detector_comparison/*.pt
*.npz
paper/**/*.pdf
